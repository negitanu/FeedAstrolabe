{
  "openapi": "3.1.0",
  "info": {
    "title": "FeedAstrolabe API",
    "version": "0.4.0",
    "description": "Bearer API key required. Cloudflare deployments additionally require Access service authentication at the edge. Dates are UTC. Article cursors use ID order."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped expiring API key issued in /settings"
      }
    }
  },
  "paths": {
    "/feeds": {
      "get": {
        "summary": "List subscriptions",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          }
        }
      },
      "post": {
        "summary": "Subscribe to RSS/Atom or an SNS source (write scope)",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "JSON error response"
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "409": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          },
          "502": {
            "description": "JSON error response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "source_type": {
                        "const": "rss"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "folder": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_type",
                      "target"
                    ],
                    "properties": {
                      "source_type": {
                        "type": "string",
                        "enum": [
                          "x",
                          "mastodon"
                        ]
                      },
                      "source_kind": {
                        "type": "string",
                        "enum": [
                          "account",
                          "list"
                        ],
                        "default": "account"
                      },
                      "target": {
                        "type": "string"
                      },
                      "instance_url": {
                        "type": "string",
                        "description": "Required HTTPS origin for Mastodon; empty for X"
                      },
                      "folder": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_type",
                      "url",
                      "selector"
                    ],
                    "properties": {
                      "source_type": {
                        "const": "page"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "selector": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "folder": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "settle_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000,
                        "default": 1000
                      },
                      "poll_interval": {
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 86400,
                        "default": 900
                      },
                      "retention_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 365,
                        "default": 90
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/feeds/{feed_id}": {
      "get": {
        "summary": "Get subscription",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          }
        },
        "parameters": [
          {
            "name": "feed_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/articles": {
      "get": {
        "summary": "List articles with cursor pagination",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "feed",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "before_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "after_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "is_read",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "is_starred",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "source_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rss",
                "x",
                "mastodon",
                "page"
              ]
            }
          }
        ]
      }
    },
    "/articles/{article_id}": {
      "get": {
        "summary": "Get article",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          }
        },
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "patch": {
        "summary": "Update read/star state (write scope)",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "JSON error response"
          },
          "403": {
            "description": "JSON error response"
          },
          "429": {
            "description": "JSON error response"
          }
        },
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "is_read": {
                    "type": "boolean"
                  },
                  "is_starred": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/feeds/{feed_id}/observe": {
      "post": {
        "summary": "Queue a page observation (write scope)",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "parameters": [
          {
            "name": "feed_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Queued"
          },
          "401": {
            "description": "Invalid key"
          },
          "403": {
            "description": "Write scope required"
          },
          "404": {
            "description": "Page observation not found"
          }
        }
      }
    }
  }
}
