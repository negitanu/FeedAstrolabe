# 必須は TUNNEL_TOKEN のみ。Access と Protect with Access は Cloudflare 側で設定する。

# 任意: アプリ内 JWT 検証
# FEEDASTROLABE_ACCESS_MODE=cloudflare を使う場合だけ設定する。
# 標準の tunnel モードでは AUD は不要。公開ホスト名は Cloudflare 側で設定する。
CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
FEEDASTROLABE_PUBLIC_HOSTS=

# Cloudflare Tunnel
# token をここに書く。別ファイルは不要。
TUNNEL_TOKEN=

# 任意: SNS調査の重要トピック抽出（AI接続でプロバイダを選択）
# キーを設定した後、画面でモデルを選びAI抽出を有効にする。
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=

# 任意: 連携
# 値そのものではなく、コンテナ内のファイルパスを書く。
# アプリ所有（UID/GID 10001、権限 0600）のファイルを非公開の /data ボリュームに置く。
# 使わない項目は空欄のまま。ホスト側の任意の秘密ファイルは不要。
FEEDASTROLABE_OLLAMA_TOKEN_FILE=
FEEDASTROLABE_DELIVERY_CONFIG_FILE=

# 対応するファイルを用意したあとの例:
# FEEDASTROLABE_OLLAMA_TOKEN_FILE=/data/ollama-token
# FEEDASTROLABE_DELIVERY_CONFIG_FILE=/data/delivery-config.json
