FROM python:3.14-slim@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY requirements-production-lock.txt requirements-observer.txt ./
RUN pip install --no-cache-dir -r requirements-production-lock.txt -r requirements-observer.txt \
    && python -m playwright install --with-deps chromium \
    && groupadd --gid 10001 feedastrolabe \
    && useradd --uid 10001 --gid 10001 --no-create-home feedastrolabe \
    && mkdir -p /run/observer && chown 10001:10001 /run/observer \
    && rm -rf /var/lib/apt/lists/*
COPY feedastrolabe ./feedastrolabe
USER 10001:10001
CMD ["python", "-m", "feedastrolabe.renderer"]
